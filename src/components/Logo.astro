---
import { negocio } from '../data/negocio.js';

interface Props {
  href?: string;
}

const { href = '#topo' } = Astro.props;
---

<a class="brand" href={href} aria-label={`${negocio.nome} — início`}>
  <span class="brand__mark" aria-hidden="true">NX</span>
  <span class="brand__stack">
    <span class="brand__name">NEXO TECH</span>
    <span class="brand__sub">assistência técnica</span>
  </span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    line-height: 1;
  }

  .brand__mark {
    padding-right: 0.08rem;
    background: linear-gradient(180deg, #b5f6ff 0%, #24d7ff 48%, #0b7dff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-family: var(--font-display);
    font-size: 2.05rem;
    font-style: italic;
    font-weight: 900;
    letter-spacing: -0.1em;
    filter: drop-shadow(0 3px 10px rgba(36, 215, 255, 0.28));
  }

  .brand__stack {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-left: 0.7rem;
    border-left: 1px solid var(--line-strong);
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-stretch: 112%;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .brand__sub {
    color: var(--muted);
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @media (max-width: 26rem) {
    .brand {
      gap: 0.5rem;
    }

    .brand__mark {
      font-size: 1.72rem;
    }

    .brand__stack {
      padding-left: 0.55rem;
    }

    .brand__name {
      font-size: 0.86rem;
    }

    .brand__sub {
      display: none;
    }
  }
</style>
